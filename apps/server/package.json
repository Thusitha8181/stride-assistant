{
  "name": "@stride/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "ingest": "tsx scripts/ingest.ts",
    "data:generate": "tsx scripts/generate-products.ts",
    "play": "tsx scripts/playground.ts",
    "chat": "tsx scripts/chat-cli.ts",
    "eval": "tsx evals/cli.ts --mode live",
    "eval:mock": "tsx evals/cli.ts --mode replay",
    "eval:record": "tsx evals/cli.ts --mode live --record"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@langchain/core": "^1.2.17",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.20",
    "@langchain/qdrant": "^1.0.3",
    "@qdrant/js-client-rest": "^1.19.0",
    "@stride/shared": "*",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "langchain": "^1.5.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/qdrant": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
