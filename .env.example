# --- API ---
PORT=4000

# --- LLM ---
# Any provider LangChain's initChatModel supports (groq, openai, anthropic, ...) once its package is installed.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=20000
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Retrieval ---
# local = HuggingFace Transformers.js model (downloaded on first use, no key)
# hash  = deterministic offline embeddings (tests, CI, no download)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_KB_COLLECTION=stride_kb
QDRANT_PRODUCTS_COLLECTION=stride_products

# --- Tracing (LangSmith) ---
# Set to true with an API key to trace every chat turn (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stride-poc
