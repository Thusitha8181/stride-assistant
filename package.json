{
  "name": "stride-assistant",
  "private": true,
  "description": "Stride Footwear AI customer assistant (POC)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@stride/server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "ingest": "npm run ingest --workspace=@stride/server",
    "data:generate": "npm run data:generate --workspace=@stride/server",
    "prepare": "husky",
    "play": "npm run play --workspace=@stride/server --",
    "chat": "npm run chat --workspace=@stride/server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "overrides": {
    "@qdrant/js-client-rest": {
      "undici": "^7.30.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --fix"
  }
}
